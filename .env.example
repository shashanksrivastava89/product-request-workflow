# Docker Compose overrides (optional).
# Copy to .env in this directory to override when running: docker compose up
# Values here apply to the backend container.

# Backend DB: default = local japanautomation on host (host.docker.internal).
# Uncomment to override (e.g. use in-container postgres when using --profile postgres):
# DATABASE_URL=postgresql://postgres:postgres_password@postgres:5432/salesform?schema=public

# Other backend vars (JWT, SMTP, etc.) are read from backend/.env via env_file.

# Frontend (Vite) — Microsoft SSO (optional). Copy to .env.local for local dev.
# VITE_AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# VITE_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional; default is {origin}/login (matches typical Azure SPA entries). Override only if needed:
# VITE_AZURE_REDIRECT_URI=http://localhost:5173/login
# Optional API scope after Expose an API in Entra (else openid ID token is used):
# VITE_AZURE_API_SCOPE=api://YOUR_CLIENT_ID/access_as_user
# Local dev only — send X-User-Email if token missing (requires ALLOW_SSO_HEADER_AUTH=true on API):
# VITE_SSO_HEADER_FALLBACK=true
