# Database (Prisma)
# Local dev (Postgres on same machine as Node):
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/salesform?schema=public"
# App runs in Docker, Postgres on host (Mac/Windows Docker Desktop):
#   DATABASE_URL="postgresql://USER:contact-94477c@outside.example:5432/salesform?schema=public"
# EC2 / Linux bare metal (host.docker.internal does NOT resolve — use loopback or RDS):
#   DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/salesform?schema=public"
#   DATABASE_URL="postgresql://USER:contact-a67031@outside.example:5432/salesform?schema=public"
DATABASE_URL="postgresql://postgres:password@localhost:5432/salesform?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# SSO (Microsoft Entra): SPA sends Authorization: Bearer <Entra ID or API access token>; API validates via JWKS.
# AZURE_TENANT_ID and AZURE_CLIENT_ID must match the Product_Request app registration (same as Graph mail vars).
# Optional: comma-separated extra audiences (e.g. api://00000000-0000-4000-8000-58b25b792bb4)
# AZURE_API_AUDIENCE=
#
# Production: disable spoofable X-User-Email (pentest remediation).
# ALLOW_SSO_HEADER_AUTH=false
#
# Local dev only: allow header fallback when MSAL token cannot be acquired (frontend VITE_SSO_HEADER_FALLBACK=true).
# ALLOW_SSO_HEADER_AUTH=true
#
# Admin bulk import: optional extra strictness (Entra Bearer or app JWT only).
# ADMIN_IMPORT_REQUIRE_BEARER=false
#
# SSO resolves login email from Entra token claims: email → upn → preferred_username (see sso-email-from-claims.util.ts).
# Ensure App registration → Token configuration includes optional ID token claim "email" when users.mail ≠ UPN.
# Fallback when the token still has only UPN but users.email uses the corporate mailbox:
# SSO_EMAIL_MAP=u119620@example.com=josiah_dearbhla@example.com
#
# If unset or true: unknown SSO email gets a synthetic user (no DB row); /auth/me works, other APIs return 403 until an admin creates users.email.
# Set to false to reject unknown SSO users with 401 (legacy behavior).
# ALLOW_UNPROVISIONED_SSO=true
#
# Public POST /api/auth/register is disabled unless explicitly enabled (pentest remediation).
# Production must leave this unset/false; provision users via admin UI or SSO + users table.
# ALLOW_PUBLIC_REGISTRATION=true

# Server
PORT=3000
NODE_ENV="development"

# CORS - allowed origins (comma-separated for multiple)
# Production: https://app.example.com
FRONTEND_URL="http://localhost:5173"

# Email — use either Microsoft Graph (preferred when set) or SMTP
#
# Graph: app registration with application permission Mail.Send + admin consent.
# AZURE_MAIL_FROM must be a real mailbox UPN in the tenant (sender identity for /users/{id}/sendMail).
# If all four AZURE_* variables are set, sendEmail() uses Graph and ignores SMTP.
# AZURE_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# AZURE_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# AZURE_CLIENT_SECRET="your-client-secret"
# AZURE_MAIL_FROM="noreply-japauto@example.com"
# Optional: comma-separated BCC on every app email (audit / archive). Omitted if unset.
# If MAIL_TEST=true (or 1), AZURE_MAIL_TO is instead the only To: address for every message (BCC disabled); required in that mode.
# AZURE_MAIL_TO="audit-team@example.com,archive@example.com"
#
# MAIL_TEST=false
#
# Order-taking: when a form is fully approved, an extra notification is sent by business unit (optional).
# Use KEY=value without spaces around "=" for reliability. Example:
# AZURE_CGD_MAIL_TO=japan_cdgordertaking@example.com,other@example.com
# AZURE_LSG_MAIL_TO=japan_lsgordertaking@example.com,other@example.com
# Comma- or semicolon-separated; all addresses receive order-taking mail when a form is fully approved.
# With MAIL_TEST=true, delivery is still only to AZURE_MAIL_TO; if CDG/LSG are unset, order-taking mail still sends in test mode when AZURE_MAIL_TO is set.
#
# SMTP (used when Graph is not fully configured)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="contact-1073d3@outside.example"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="Sales Form System <contact-090c5b@outside.example>"

# Application
APP_NAME="Sales Form Approval System"
APP_URL="http://localhost:3000"

# Approval mapping (admin API): set to true to skip requester-directory and approver user-name checks (bulk import / migrations only).
# APPROVAL_MAPPING_SKIP_DIRECTORY_VALIDATION=false
