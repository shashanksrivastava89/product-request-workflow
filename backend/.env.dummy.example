# Copy to .env.dummy and set SMTP_PASSWORD. Do not commit .env.dummy.
# From project root: npm run send-email-dummy -- --to "you@example.com" --subject "Test" --body "Hi"
# If you get 535 / "Authentication unsuccessful" or "You cannot access this right now", see docs/send-email-dummy.md

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=app-dev@example.com
SMTP_PASSWORD=
EMAIL_FROM=app-dev@example.com
